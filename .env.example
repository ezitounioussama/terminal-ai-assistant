# Copy this file to .env and put your real key in it:
#   cp .env.example .env
#
# Get a key from https://platform.openai.com/api-keys
# .env is listed in .gitignore, so it is never committed.

OPENAI_API_KEY=your-api-key-here

# Optional. A small, inexpensive model is enough for learning tasks.
# Alternatives: gpt-4.1-mini, gpt-5-mini
MODEL=gpt-4o-mini
